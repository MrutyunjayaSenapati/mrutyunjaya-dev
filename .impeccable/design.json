  "narrative": {
    "northStar": "The System Blueprint",
    "overview": "A dark-first engineering portfolio presented the way an engineer would build it: as a measured, drafted, verifiable system. Surfaces sit flat behind hairline borders; depth appears only on interaction; metadata is spoken in monospace readouts. The palette is indigo on cool slate, with cyan used as a tracer and a signature indigo → purple → cyan gradient family reserved for the hero wordmark, the scroll progress bar, and the tech constellation.",
    "keyCharacteristics": [
      "Flat-at-rest surfaces separated by 1px hairline borders",
      "Indigo #6366f1 is the single action color, used on ~10% of any screen",
      "Cyan #06b6d4 appears only as a tracer on terminal readouts, diagrams, and sparse glows",
      "Cool slate neutrals (no warm or ember tones)",
      "A signature indigo → purple → cyan gradient family limited to the hero wordmark, scroll progress, and constellation",
      "Monospace readouts for all metadata (labels, stats, tags, eyebrows)",
      "Precise, tactile interactive states: press-scale, crisp focus rings, snappy color transitions"
    ],
    "rules": [
      "The Blueprint Rule: hairline borders separate flat surfaces; depth is reserved for interaction, never ambient.",
      "The Readout Rule: metadata speaks in JetBrains Mono; narrative in Inter; headlines in Space Grotesk.",
      "The Measurement Rule: radii come only from the five-rung ladder (8 / 12 / 16 / 24 / full).",
      "The One-Voice Rule: Indigo carries every action; Cyan traces; Purple appears only inside the gradient stops.",
      "The Gradient Rule: the indigo → purple → cyan gradient family lives only on the hero wordmark, the scroll progress bar, and the constellation — never as a background wash."
    ],
    "dos": [
      "Keep surfaces flat at rest with hairline borders.",
      "Use the radius ladder; never freeform corners.",
      "Speak metadata in monospace uppercase readouts.",
      "Make interaction states tactile (press-scale, focus-visible ring, 0.3s transitions).",
      "Stay cool: slate neutrals, indigo actions, cyan tracers, purple only in gradient stops."
    ],
    "donts": [
      "No ambient drop shadows at rest (glass panels are the one sanctioned exception).",
      "No warm hues — no ember, amber, copper, or warm charcoal anywhere.",
      "No arbitrary radii or inconsistent corner styles.",
      "Don't let the gradient family bleed into backgrounds, buttons, or panels — it belongs on the wordmark, progress bar, and constellation.",
      "No AI-gradient hype-page decoration (emoji-dense, glass-everywhere, glitter)."
    ]
  }
